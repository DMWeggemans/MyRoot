indent_style = space
indent_size = 4

#
# BACKEND #
#

[*.cs]
# Disable ('new' expression can be simplified)
dotnet_diagnostic.IDE0090.severity = none
# Disable (Use primary constructor)
dotnet_diagnostic.IDE0290.severity = none
# Disable (Prefer using 'string.Equals(string, StringComparison)' to perform a case-insensitive comparison)
dotnet_diagnostic.CA1862.severity = none

[**/Migrations/*.cs]
# Disable all warnings and messages
generated_code = true